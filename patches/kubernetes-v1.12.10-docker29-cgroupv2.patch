+func getUnifiedCgroupV2Path(cgroupManager cgroups.Manager) (string, bool) {
+	paths := cgroupManager.GetPaths()
+	for _, subsystem := range []string{"memory", "cpu", "cpuset", "blkio", "devices"} {
+		cgroupPath, ok := paths[subsystem]
+		if ok {
+			if _, err := os.Stat(path.Join(cgroupPath, "cgroup.controllers")); err == nil {
+				return path.Clean(cgroupPath), true
+			}
+		}
+	}
+	for _, cgroupPath := range paths {
+		if _, err := os.Stat(path.Join(cgroupPath, "cgroup.controllers")); err == nil {
+			return path.Clean(cgroupPath), true
+		}
+	}
+	return "", false
+}
+
+func readCgroupV2Uint(cgroupPath, name string) (uint64, error) {
+	contents, err := ioutil.ReadFile(path.Join(cgroupPath, name))
+	if err != nil {
+		return 0, err
+	}
+	value := strings.TrimSpace(string(contents))
+	if value == "max" {
+		return ^uint64(0), nil
+	}
+	parsed, err := strconv.ParseUint(value, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("failed to parse %s: %v", path.Join(cgroupPath, name), err)
+	}
+	return parsed, nil
+}
+
+func readCgroupV2KeyValues(cgroupPath, name string) (map[string]uint64, error) {
+	filePath := path.Join(cgroupPath, name)
+	file, err := os.Open(filePath)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+
+	values := make(map[string]uint64)
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		fields := strings.Fields(scanner.Text())
+		if len(fields) != 2 {
+			return nil, fmt.Errorf("invalid cgroup v2 key/value in %s: %q", filePath, scanner.Text())
+		}
+		value, err := strconv.ParseUint(fields[1], 10, 64)
+		if err != nil {
+			return nil, fmt.Errorf("failed to parse cgroup v2 value in %s: %v", filePath, err)
+		}
+		values[fields[0]] = value
+	}
+	if err := scanner.Err(); err != nil {
+		return nil, err
+	}
+	return values, nil
+}
+
+func readCgroupV2IoStats(cgroupPath string) (info.DiskIoStats, error) {
+	var stats info.DiskIoStats
+	filePath := path.Join(cgroupPath, "io.stat")
+	file, err := os.Open(filePath)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return stats, nil
+		}
+		return stats, err
+	}
+	defer file.Close()
+
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		fields := strings.Fields(scanner.Text())
+		if len(fields) < 2 {
+			continue
+		}
+		device := strings.Split(fields[0], ":")
+		if len(device) != 2 {
+			continue
+		}
+		major, err := strconv.ParseUint(device[0], 10, 64)
+		if err != nil {
+			return stats, fmt.Errorf("failed to parse io.stat major device in %s: %v", filePath, err)
+		}
+		minor, err := strconv.ParseUint(device[1], 10, 64)
+		if err != nil {
+			return stats, fmt.Errorf("failed to parse io.stat minor device in %s: %v", filePath, err)
+		}
+		bytesByOperation := map[string]uint64{}
+		operationsByType := map[string]uint64{}
+		for _, field := range fields[1:] {
+			parts := strings.SplitN(field, "=", 2)
+			if len(parts) != 2 {
+				continue
+			}
+			value, err := strconv.ParseUint(parts[1], 10, 64)
+			if err != nil {
+				return stats, fmt.Errorf("failed to parse io.stat value in %s: %v", filePath, err)
+			}
+			switch parts[0] {
+			case "rbytes":
+				bytesByOperation["Read"] = value
+			case "wbytes":
+				bytesByOperation["Write"] = value
+			case "dbytes":
+				bytesByOperation["Discard"] = value
+			case "rios":
+				operationsByType["Read"] = value
+			case "wios":
+				operationsByType["Write"] = value
+			case "dios":
+				operationsByType["Discard"] = value
+			}
+		}
+		if len(bytesByOperation) > 0 {
+			stats.IoServiceBytes = append(stats.IoServiceBytes, info.PerDiskStats{
+				Major: major,
+				Minor: minor,
+				Stats: bytesByOperation,
+			})
+		}
+		if len(operationsByType) > 0 {
+			stats.IoServiced = append(stats.IoServiced, info.PerDiskStats{
+				Major: major,
+				Minor: minor,
+				Stats: operationsByType,
+			})
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return stats, err
+	}
+	return stats, nil
+}

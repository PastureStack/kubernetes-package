+func TestGetSpecReadsUnifiedCgroupV2Limits(t *testing.T) {
+	dir := newCgroupV2Fixture(t)
+	defer os.RemoveAll(dir)
+
+	writeCgroupV2Fixture(t, dir, "cpu.stat", "usage_usec 1\n")
+	writeCgroupV2Fixture(t, dir, "cpu.weight", "100\n")
+	writeCgroupV2Fixture(t, dir, "cpu.max", "200000 100000\n")
+	writeCgroupV2Fixture(t, dir, "cpuset.cpus.effective", "0-3\n")
+	writeCgroupV2Fixture(t, dir, "memory.stat", "anon 1\n")
+	writeCgroupV2Fixture(t, dir, "memory.max", "1073741824\n")
+	writeCgroupV2Fixture(t, dir, "memory.swap.max", "536870912\n")
+	writeCgroupV2Fixture(t, dir, "memory.low", "134217728\n")
+	writeCgroupV2Fixture(t, dir, "io.stat", "8:0 rbytes=1\n")

+	spec, err := GetSpec(map[string]string{"cpu": dir}, &cgroupV2MachineInfoFactory{
+		machine: &info.MachineInfo{NumCores: 4},
+	}, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !spec.HasCpu || spec.Cpu.Limit != 2597 || spec.Cpu.Quota != 200000 || spec.Cpu.Period != 100000 || spec.Cpu.Mask != "0-3" {
+		t.Fatalf("unexpected CPU spec: %#v", spec.Cpu)

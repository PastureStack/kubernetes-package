+	if !spec.HasMemory || spec.Memory.Limit != 1073741824 || spec.Memory.SwapLimit != 1610612736 || spec.Memory.Reservation != 134217728 {
+		t.Fatalf("unexpected memory spec: %#v", spec.Memory)

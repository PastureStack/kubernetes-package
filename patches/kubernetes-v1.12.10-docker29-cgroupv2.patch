+type dockerAPIFsHandler struct {
+	sync.RWMutex
+	client      *docker.Client
+	containerID string
+	extraDir    string
+	fsInfo      fs.FsInfo
+	usage       common.FsUsage
+	stopChan    chan struct{}
+}
+
+var _ common.FsHandler = &dockerAPIFsHandler{}
+
+func newDockerAPIFsHandler(client *docker.Client, containerID, extraDir string, fsInfo fs.FsInfo) common.FsHandler {
+	return &dockerAPIFsHandler{
+		client:      client,
+		containerID: containerID,
+		extraDir:    extraDir,
+		fsInfo:      fsInfo,
+		stopChan:    make(chan struct{}),
+	}
+}
+
+func (h *dockerAPIFsHandler) update() error {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	containerInfo, _, err := h.client.ContainerInspectWithRaw(ctx, h.containerID, true)
+	if err != nil {
+		return err
+	}
+	if containerInfo.ContainerJSONBase == nil || containerInfo.SizeRw == nil || *containerInfo.SizeRw < 0 {
+		return fmt.Errorf("Docker did not report writable-layer usage for container %q", h.containerID)
+	}
+
+	baseUsage := uint64(*containerInfo.SizeRw)
+	extraUsage, extraErr := h.fsInfo.GetDirDiskUsage(h.extraDir, 2*time.Minute)
+	h.Lock()
+	h.usage.BaseUsageBytes = baseUsage
+	h.usage.TotalUsageBytes = baseUsage + extraUsage
+	h.Unlock()
+	return extraErr
+}
+
+func (h *dockerAPIFsHandler) trackUsage() {
+	if err := h.update(); err != nil {
+		glog.Errorf("failed to collect Docker API filesystem stats for %s: %v", h.containerID, err)
+	}
+	ticker := time.NewTicker(common.DefaultPeriod)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ticker.C:
+			if err := h.update(); err != nil {
+				glog.Errorf("failed to collect Docker API filesystem stats for %s: %v", h.containerID, err)
+			}
+		case <-h.stopChan:
+			return
+		}
+	}
+}
+
+func (h *dockerAPIFsHandler) Start() {
+	go h.trackUsage()
+}
+
+func (h *dockerAPIFsHandler) Stop() {
+	select {
+	case <-h.stopChan:
+	default:
+		close(h.stopChan)
+	}
+}
+
+func (h *dockerAPIFsHandler) Usage() common.FsUsage {
+	h.RLock()
+	defer h.RUnlock()
+	return h.usage
+}

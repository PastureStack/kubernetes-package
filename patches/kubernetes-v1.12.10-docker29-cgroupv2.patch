+func getUnifiedCgroupV2Path(cgroupPaths map[string]string) (string, bool) {
+	for _, subsystem := range []string{"memory", "cpu", "cpuset", "blkio", "devices"} {
+		cgroupPath, ok := cgroupPaths[subsystem]
+		if ok && utils.FileExists(path.Join(cgroupPath, "cgroup.controllers")) {
+			return cgroupPath, true
+		}
+	}
+	for _, cgroupPath := range cgroupPaths {
+		if utils.FileExists(path.Join(cgroupPath, "cgroup.controllers")) {
+			return cgroupPath, true
+		}
+	}
+	return "", false
+}
+
+func readCgroupV2Limit(dirpath, file string, unlimited uint64) uint64 {
+	value := readString(dirpath, file)
+	if value == "max" {
+		return unlimited
+	}
+	if value == "" {
+		return unlimited
+	}
+	parsed, err := strconv.ParseUint(value, 10, 64)
+	if err != nil {
+		glog.Errorf("GetSpec: Failed to parse cgroup v2 limit from %q: %s", path.Join(dirpath, file), err)
+		return 0
+	}
+	return parsed
+}
+
+func cpuWeightToShares(weight uint64) uint64 {
+	if weight < 1 {
+		return 0
+	}
+	if weight > 10000 {
+		weight = 10000
+	}
+	return 2 + ((weight - 1) * 262142 / 9999)
+}
+
+func getCgroupV2Spec(cgroupPath string, mi *info.MachineInfo, hasNetwork, hasFilesystem bool) info.ContainerSpec {
+	var spec info.ContainerSpec
+	unlimited := ^uint64(0)
+	if fi, err := os.Stat(cgroupPath); err == nil {
+		spec.CreationTime = fi.ModTime()
+	}
+
+	if utils.FileExists(path.Join(cgroupPath, "cpu.stat")) {
+		spec.HasCpu = true
+		spec.Cpu.Limit = cpuWeightToShares(readUInt64(cgroupPath, "cpu.weight"))
+		fields := strings.Fields(readString(cgroupPath, "cpu.max"))
+		if len(fields) == 2 {
+			spec.Cpu.Period, _ = strconv.ParseUint(fields[1], 10, 64)
+			if fields[0] != "max" {
+				spec.Cpu.Quota, _ = strconv.ParseUint(fields[0], 10, 64)
+			}
+		}
+	}
+	if utils.FileExists(path.Join(cgroupPath, "cpuset.cpus.effective")) || utils.FileExists(path.Join(cgroupPath, "cpuset.cpus")) {
+		spec.HasCpu = true
+		mask := readString(cgroupPath, "cpuset.cpus.effective")
+		if mask == "" {
+			mask = readString(cgroupPath, "cpuset.cpus")
+		}
+		spec.Cpu.Mask = utils.FixCpuMask(mask, mi.NumCores)
+	}
+
+	if utils.FileExists(path.Join(cgroupPath, "memory.stat")) {
+		spec.HasMemory = true
+		spec.Memory.Limit = readCgroupV2Limit(cgroupPath, "memory.max", unlimited)
+		swapLimit := readCgroupV2Limit(cgroupPath, "memory.swap.max", unlimited)
+		if spec.Memory.Limit == unlimited || swapLimit == unlimited {
+			spec.Memory.SwapLimit = unlimited
+		} else if unlimited-spec.Memory.Limit < swapLimit {
+			spec.Memory.SwapLimit = unlimited
+		} else {
+			spec.Memory.SwapLimit = spec.Memory.Limit + swapLimit
+		}
+		spec.Memory.Reservation = readCgroupV2Limit(cgroupPath, "memory.low", 0)
+	}
+
+	spec.HasNetwork = hasNetwork
+	spec.HasFilesystem = hasFilesystem
+	spec.HasDiskIo = utils.FileExists(path.Join(cgroupPath, "io.stat"))
+	return spec
+}

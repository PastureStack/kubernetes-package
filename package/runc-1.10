#!/bin/bash

shift 1

while [ "$#" -gt 0 ]; do
    if [ "$1" = "-e" ]; then
        shift 2
    else
        break
    fi
done

if [ -n "${PASTURESTACK_DOCKER_API_VERSION:-}" ]; then
    export DOCKER_API_VERSION="${PASTURESTACK_DOCKER_API_VERSION}"
elif [ -z "${DOCKER_API_VERSION:-}" ]; then
    unset DOCKER_API_VERSION
fi
PID=$(docker inspect -f '{{.State.Pid}}' $1)

shift 1
nsenter -m -u -i -n -p -t $PID "$@" 

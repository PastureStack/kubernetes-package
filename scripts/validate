#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

for script in scripts/package scripts/ci scripts/release; do
    bash -n "$script"
done

test "$(grep -c '^FROM ' package/Dockerfile)" -eq 3
test "$(grep -c 'golang:1.27.0-bookworm@sha256:484ef6066fa69acb059fdfeda7ba2b8f7391f2ef6abc6f9b8411e669ebd56466' package/Dockerfile)" -eq 2
grep -Fxq 'FROM scratch' package/Dockerfile
grep -Fq 'ARG KUBERNETES_VERSION=v1.36.4' package/Dockerfile
grep -Fq 'ARG KUBERNETES_GIT_COMMIT=bb826b1d48562f110659e64e8ec444327433db95' package/Dockerfile
grep -Fq 'ARG KUBERNETES_SOURCE_SHA256=3c28f11492472df48e658551bf268fd92938b127b0f9dcef7090ac800318c821' package/Dockerfile
grep -Fq 'ARG OPENTELEMETRY_VERSION=v1.45.0' package/Dockerfile
grep -Fq 'ARG OPENTELEMETRY_GRPC_VERSION=v0.70.0' package/Dockerfile
test "$(grep -Fc 'ARG GRPC_GO_VERSION=v1.83.2' package/Dockerfile)" -eq 2
grep -Fq 'ARG CEL_GO_VERSION=v0.32.0' package/Dockerfile
grep -Fq 'ARG ETCD_VERSION=v3.7.1' package/Dockerfile
grep -Fq 'ARG ETCD_RAFT_VERSION=v3.7.0' package/Dockerfile
test "$(grep -Fc 'ARG X_CRYPTO_VERSION=v0.56.0' package/Dockerfile)" -eq 2
grep -Fq 'ARG X_SYS_VERSION=v0.47.0' package/Dockerfile
grep -Fq 'ARG CNI_VERSION=v1.9.1' package/Dockerfile
grep -Fq 'ARG CNI_GIT_COMMIT=adc3e6b5b581638afbd194cf2e9319ecbb0151a1' package/Dockerfile
grep -Fq 'ARG CNI_GIT_TREE=91451a8931a305da27de4df81662ec08af58249e' package/Dockerfile
grep -Fq 'io.pasturestack.cloud-provider="external-required"' package/Dockerfile
grep -Fq 'io.pasturestack.legacy-rancher16-compatible="false"' package/Dockerfile
grep -Fq 'io.pasturestack.runtime.base="scratch"' package/Dockerfile
grep -Fq 'vulnerable_code_not_present' security/openvex.json
grep -Fq 'expected_version=v1.36.4' scripts/release
grep -Fq 'TAG: v1.36.4' .github/workflows/security-release-gate.yml

active_paths=(package/Dockerfile scripts/package Makefile .github/workflows/security-release-gate.yml)
if grep -n -i -E 'v?1\.12\.|helm[ -]?2|azure-cli|python.?cryptography|kube-dns|runc-1\.10|tiller-deploy|TILLER_' "${active_paths[@]}"; then
    echo 'An EOL runtime dependency remains active' >&2
    exit 1
fi

removed_paths=(
    Dockerfile.dapper
    addon-templates
    dns-image
    patches
    package/addons-update.sh
    package/dns.sed
    package/runc-1.10
    package/entry.sh
    package/ubuntu-apt.lock
    package/update-platform-ca
    package/utils.sh
    package/verify-azure-python-security
    scripts/entry
    scripts/generate-dapper-openvex
    scripts/prepare-cluster-dns-source
    scripts/tiller-release-backup
    scripts/verify-go-toolchain-compatibility
    scripts/version
    tests
)
for removed_path in "${removed_paths[@]}"; do
    if [ -f "$removed_path" ] || [ -L "$removed_path" ] || \
        { [ -d "$removed_path" ] && find "$removed_path" -mindepth 1 \( -type f -o -type l \) -print -quit | grep -q .; }; then
        echo "Legacy path still exists: ${removed_path}" >&2
        exit 1
    fi
done

test "$(find . -type f -not -path './.git/*' -not -path './dist/*' | wc -l)" -le 20
git diff --check
echo 'KUBERNETES_PACKAGE_VALIDATE_OK kubernetes=v1.36.4 cni=v1.9.1 compiler=go1.27.0 runtime=scratch legacy=removed'

#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "${repo_root}"
source "${repo_root}/scripts/version"

if [ -z "${SOURCE_REVISION:-}" ]; then
    SOURCE_REVISION=$(git -C "${repo_root}" rev-parse HEAD)
    if [ -n "$(git -C "${repo_root}" status --porcelain)" ]; then
        SOURCE_REVISION="${SOURCE_REVISION}-dirty"
    fi
fi
if ! [[ "${SOURCE_REVISION}" =~ ^[0-9a-f]{40}(-dirty)?$ ]]; then
    echo "SOURCE_REVISION must be a full Git commit, optionally suffixed with -dirty for a local candidate" >&2
    exit 1
fi

ARCH=${ARCH:-"amd64"}
SUFFIX=""
[ "${ARCH}" != "amd64" ] && SUFFIX="_${ARCH}"

cd "${repo_root}/package"

KUBERNETES_SOURCE_COMMIT=71fde6aadce8b92456b88ee56c21e500f4919f0b
KUBERNETES_SOURCE_DATE_EPOCH=1567540757
KUBERNETES_BINARY_VERSION=${KUBERNETES_BINARY_VERSION:-v1.12.10-pasturestack.4}
KUBERNETES_SERVER_SHA256=f3df06f9bf2e4c4e8b5aba16d44197e26672aa06e8c24ab9f6ab4eaf64ab068e
KUBERNETES_PATCH=../patches/kubernetes-v1.12.10-docker29-cgroupv2.patch
KUBERNETES_GO_PATCH=../patches/kubernetes-v1.12.10-go1.26.patch
KUBERNETES_BUILD_ROOT=$(mktemp -d /tmp/pasturestack-kubernetes-build.XXXXXX)
KUBERNETES_GOPATH=${KUBERNETES_BUILD_ROOT}/gopath
KUBERNETES_SOURCE_ROOT=${KUBERNETES_GOPATH}/src/k8s.io/kubernetes

cleanup() {
    rm -f kubectl kubelet kube-proxy kube-apiserver kube-controller-manager kube-scheduler \
        LICENSE SECURITY.md ORIGIN.md COMPATIBILITY.md
    if [ -n "${KUBERNETES_BUILD_ROOT:-}" ]; then
        rm -rf "${KUBERNETES_BUILD_ROOT}"
    fi
}
trap cleanup EXIT

TAG=${TAG:-${VERSION}${SUFFIX}}
REPO=${REPO:-pasturestack}
IMAGE_NAME=${IMAGE_NAME:-}
IMAGE=${IMAGE:-}

if echo $TAG | grep -q dirty; then
    TAG=dev
fi

echo "${KUBERNETES_SERVER_SHA256}  ${DOWNLOAD}/k8s.tar.gz" | sha256sum -c -
tar xvzf $DOWNLOAD/k8s.tar.gz --strip-components=3 kubernetes/server/bin/{kubelet,kube-proxy,kube-apiserver,kube-controller-manager,kube-scheduler,kubectl}
tar xOzf $DOWNLOAD/k8s.tar.gz kubernetes/kubernetes-src.tar.gz > "${KUBERNETES_BUILD_ROOT}/kubernetes-src.tar.gz"
mkdir -p "${KUBERNETES_SOURCE_ROOT}"
tar xzf "${KUBERNETES_BUILD_ROOT}/kubernetes-src.tar.gz" \
    -C "${KUBERNETES_SOURCE_ROOT}"

(
    cd "${KUBERNETES_SOURCE_ROOT}"
    patch --batch --forward --fuzz=0 -p1 < "${OLDPWD}/${KUBERNETES_PATCH}"
    patch --batch --forward --fuzz=0 -p1 < "${OLDPWD}/${KUBERNETES_GO_PATCH}"
    KUBERNETES_VERSION_FILE="${KUBERNETES_BUILD_ROOT}/version-vars"
    cat > "${KUBERNETES_VERSION_FILE}" <<EOF
KUBE_GIT_COMMIT='${KUBERNETES_SOURCE_COMMIT}'
KUBE_GIT_TREE_STATE='clean'
KUBE_GIT_VERSION='${KUBERNETES_BINARY_VERSION}'
KUBE_GIT_MAJOR='1'
KUBE_GIT_MINOR='12+'
EOF
    KUBE_GIT_VERSION_FILE="${KUBERNETES_VERSION_FILE}" \
    SOURCE_DATE_EPOCH="${KUBERNETES_SOURCE_DATE_EPOCH}" \
    GOPATH="${KUBERNETES_GOPATH}" \
    GO111MODULE=off \
    GOTOOLCHAIN=local \
    bash -c '
        source hack/lib/init.sh
        kubelet_ldflags="$(kube::version::ldflags)"
        mkdir -p _output/local/bin/linux/amd64
        CGO_ENABLED=1 go build \
            -trimpath \
            -ldflags "${kubelet_ldflags}" \
            -o _output/local/bin/linux/amd64/kubelet \
            ./cmd/kubelet
    '
    install -m 0755 _output/local/bin/linux/amd64/kubelet "${OLDPWD}/kubelet"
)

actual_kubelet_version=$(./kubelet --version)
if [ "${actual_kubelet_version}" != "Kubernetes ${KUBERNETES_BINARY_VERSION}" ]; then
    echo "unexpected kubelet version: ${actual_kubelet_version}" >&2
    exit 1
fi
if grep -a -Fq "${KUBERNETES_BUILD_ROOT}" kubelet; then
    echo "KUBERNETES_PACKAGE_NON_REPRODUCIBLE_PATH_PRESENT" >&2
    exit 1
fi
rm -rf "${KUBERNETES_BUILD_ROOT}"
KUBERNETES_BUILD_ROOT=

mkdir -p kubernetes/cluster/addons

cp -r ../addon-templates/kubectl/* kubernetes/cluster/addons/
cp ../LICENSE ../SECURITY.md ../ORIGIN.md ../COMPATIBILITY.md .

for t in kubernetes/cluster/addons/dns/*.yaml.sed; do
    sed -f dns.sed <${t} >${t%.sed} && rm ${t}
    echo ${t%.sed}
done

if [ -z "${IMAGE}" ]; then
    if [ -n "${IMAGE_NAME}" ]; then
        IMAGE="${IMAGE_NAME}:${TAG}"
    else
        IMAGE="${REPO}/k8s:${TAG}"
    fi
fi

docker build \
    --build-arg "IMAGE_VERSION=${TAG}" \
    --build-arg "SOURCE_REVISION=${SOURCE_REVISION}" \
    -t "${IMAGE}" .
test "$(docker image inspect "${IMAGE}" --format '{{index .Config.Labels "org.opencontainers.image.source"}}')" = \
    "https://github.com/PastureStack/kubernetes-package"
test "$(docker image inspect "${IMAGE}" --format '{{index .Config.Labels "org.opencontainers.image.version"}}')" = "${TAG}"
test "$(docker image inspect "${IMAGE}" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')" = "${SOURCE_REVISION}"
echo "${IMAGE}" > ../dist/images
echo "Built ${IMAGE} from ${SOURCE_REVISION}"
